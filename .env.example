# ==========================================
# Service & Health Check Configuration
# ==========================================
API_URL=http://localhost:8000/general/v0/general
CONTAINER_NAME=unstructured-api
CHECK_INTERVAL_SECONDS=30
MAX_RETRIES=3
RETRY_DELAY_SECONDS=15
LOG_FILE=api_monitor.log

# ==========================================
# Alert Rate Limiting & Cooldown
# ==========================================
MAX_ALERTS=5
ALERT_COOLDOWN_SECONDS=200

# ==========================================
# Notification Recipients (Comma-separated for multiple)
# ==========================================
RECIPIENT_EMAILS=alerts@example.com

# ==========================================
# Microsoft Graph API Configuration (Recommended)
# ==========================================
SENDER_EMAIL_MS=alerts@yourdomain.com
CLIENT_ID=your_azure_client_id_here
CLIENT_SECRET=your_azure_client_secret_here
TENANT_ID=your_azure_tenant_id_here

# ==========================================
# Gmail SMTP Configuration (Fallback / Alternative)
# ==========================================
SMTP_SERVER_GMAIL=smtp.gmail.com
SMTP_PORT_GMAIL=587
SENDER_EMAIL_GMAIL=your_gmail@gmail.com
SENDER_PASSWORD_GMAIL=your_gmail_app_password_here
